{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hangul-durak-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "Room"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Room"]}],
  "vars": {
    "NETWORK_GAME_MODE": "magic",
"FRONTEND_ORIGIN": "https://korean-card-game-multiplayer.pages.dev",
"ALLOWED_ORIGINS": "https://korean-card-game-multiplayer.pages.dev,http://localhost:5173,http://127.0.0.1:5173,https://hangul-durak.netlify.app,https://averanges.github.io",
    "WAITING_TTL_SECONDS": "14400",
    "ROOM_TTL_SECONDS": "86400",
    "EXPIRED_RETENTION_SECONDS": "3600"
  },
  "observability": {"enabled": false}
}
